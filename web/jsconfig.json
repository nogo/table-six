{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "checkJs": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["."],
  // The service worker has its own globals; `jsconfig.sw.json` checks it.
  "exclude": ["sw.js"]
}
