{
  // The service worker runs in a worker scope, not a page: its globals
  // (`self.skipWaiting`, `FetchEvent`) clash with the DOM lib, so it is
  // checked on its own. `tsc -p web/jsconfig.sw.json`
  "compilerOptions": {
    "lib": ["ESNext", "WebWorker"],
    "types": [],
    "target": "ESNext",
    "module": "ESNext",
    "checkJs": true,
    "strict": true,
    "noEmit": true
  },
  "files": ["sw.js"]
}
